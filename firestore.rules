rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Card designs are readable by anyone (so the calculator can load them)
    // but only writable by authenticated admin users.
    match /card_designs/{designId} {
      allow read: if true;
      // ONLY the designated admin account can modify designs.
      // Replace AERHxc73wQQdEql9vwazjUYG1J93 with your actual Firebase User UID.
      allow write: if request.auth != null && request.auth.uid == 'AERHxc73wQQdEql9vwazjUYG1J93';
    }
  }
}
