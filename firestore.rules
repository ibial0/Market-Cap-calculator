rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Card designs — readable by anyone, writable only by admin
    match /card_designs/{designId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == 'AERHxc73wQQdEql9vwazjUYG1J93';
    }

    // PNG Templates — readable by anyone (public site needs to load them),
    // writable only by admin
    match /png_templates/{templateId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == 'AERHxc73wQQdEql9vwazjUYG1J93';
    }
  }
}
