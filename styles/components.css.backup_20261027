/* Glass Panel */
.glass-panel {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 1.25rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    min-width: 0; /* allow compression inside grid/flex */
}

.glass-panel.calculator-form {
    padding: 1rem;
}

/* Inputs */
.input-group { margin-bottom: 1rem; }
.input-group:last-child { margin-bottom: 0; }

.input-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.input-wrapper {
    display: flex;
    align-items: center;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.3rem;
    transition: border-color 0.2s ease;
    overflow: hidden;
    min-width: 0;
}

.input-wrapper:focus-within {
    border-color: var(--accent-primary);
}

.prefix {
    color: var(--text-secondary);
    padding-left: 0.65rem;
    font-weight: 600;
    font-size: 1rem;
}

.amount-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    padding: 0.4rem 0.6rem;
    outline: none;
    width: 100%;
}

.amount-input::placeholder { color: var(--text-secondary); opacity: 0.3; }

/* Multiplier Toggles */
.multiplier-group {
    display: flex;
    gap: 0.2rem;
    background: var(--bg-secondary);
    border-radius: 8px;
    padding: 3px;
}

.mul-btn {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    width: 34px; height: 30px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.mul-btn.active {
    background: var(--accent-primary);
    color: #0a0f1c;
    box-shadow: 0 2px 8px rgba(0, 242, 254, 0.3);
}

/* Results Panel */
.results-panel {
    background: var(--bg-secondary);
    border: 1px solid rgba(0, 242, 254, 0.2);
    position: relative;
    overflow: hidden;
    padding: 1rem;
}

/* .results-panel::before removed - new Tailwind design uses border-primary */

.result-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
}

.result-item.full-width { grid-column: 1 / -1; }

.result-label {
    font-size: 0.72rem;
    color: var(--text-secondary);
    margin-bottom: 0.15rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.result-value {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
}

.result-item.full-width .result-value {
    font-size: 1.75rem;
}

.result-sub {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 0.2rem;
    font-weight: 500;
    font-family: var(--font-mono);
}

/* ── Redesigned 2-row Results Layout ─────────────── */
.result-main-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.65rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--border);
}

.result-main-item {
    flex: 1;
}

.result-sub-row {
    display: flex;
    gap: 0;
}

.result-sub-item {
    flex: 1;
}

/* Sub-row values are styled via descendant — safe when JS overwrites className */
.result-sub-item .result-value {
    font-size: 1.15rem;
    line-height: 1.2;
}

.result-sub-divider {
    border-left: 1px solid var(--border);
    padding-left: 1rem;
}

.result-value-lg {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.1;
}

.result-value-sm {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
}

.value-green { color: var(--success) !important; }
.value-red { color: var(--danger) !important; }

/* Secondary Inputs (User info) */
.meta-inputs {
    display: flex;
    gap: 1rem;
}

.meta-inputs .input-wrapper {
    padding: 0;
}

.meta-inputs .amount-input {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.95rem;
    padding: 0.65rem 0.9rem;
}

/* Primary Button */
.btn-primary {
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: #0a0f1c; 
    border: none;
    border-radius: 14px;
    padding: 0.9rem 1rem;
    font-size: 1rem;
    font-weight: 800;
    font-family: var(--font-display);
    cursor: pointer;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    transition: transform 0.1s ease, box-shadow 0.2s ease;
    box-shadow: 0 6px 20px rgba(0, 242, 254, 0.2);
}

.btn-primary:hover {
    box-shadow: 0 8px 25px rgba(0, 242, 254, 0.35);
}

.btn-primary:active {
    transform: scale(0.97);
    box-shadow: 0 3px 12px rgba(0, 242, 254, 0.15);
}

/* Secondary Button */
.btn-secondary {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.65rem 0.75rem;
    font-size: 0.82rem;
    font-weight: 600;
    font-family: var(--font-display);
    cursor: pointer;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.1s ease;
    white-space: nowrap;
}

.btn-secondary:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--accent-primary);
    color: var(--text-primary);
}

.btn-secondary:active {
    transform: scale(0.97);
}

/* Outline Button */
.btn-outline {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 14px;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.9rem;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}

.btn-outline:hover {
    border-color: var(--accent-primary);
    color: var(--text-primary);
}

/* ── Input Label Row (for DCA toggle inline) ─────── */
.input-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.4rem;
}

.dca-toggle-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    user-select: none;
}

.dca-toggle-text {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.dca-chk { display: none; }

.toggle-switch-mini {
    display: inline-block;
    width: 34px;
    height: 18px;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 18px;
    position: relative;
    transition: background 0.2s ease, border-color 0.2s ease;
    flex-shrink: 0;
}

.toggle-switch-mini::after {
    content: '';
    position: absolute;
    width: 12px; height: 12px;
    background: var(--text-secondary);
    border-radius: 50%;
    top: 2px; left: 2px;
    transition: transform 0.2s ease, background 0.2s ease;
}

.dca-chk:checked + .toggle-switch-mini {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
}

.dca-chk:checked + .toggle-switch-mini::after {
    transform: translateX(16px);
    background: #0a0f1c;
}

/* value colors */
.value-green { color: var(--success) !important; }
.value-red   { color: var(--danger)  !important; }

/* ── Calc Mode Switch ──────────────────────────── */
.calc-mode-container {
    display: flex;
    gap: 5px;
    background: rgba(10, 15, 28, 0.7);
    padding: 4px;
    border-radius: 12px;
    margin-bottom: 1rem;
    border: 1px solid var(--border);
}

.calc-mode-btn {
    flex: 1;
    padding: 7px 10px;
    border: none;
    border-radius: 8px;
    font-family: var(--font-main);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    background: transparent;
    color: var(--text-secondary);
}

/* Active state is managed by JS via inline style, this is the base/default */
.calc-mode-btn.active {
    background: var(--accent-primary);
    color: #000;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(0, 242, 254, 0.25);
}

/* ── Preview Action Button Rows ─────────────────── */
.preview-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 0.875rem;
}

.preview-actions-secondary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 14px;
}

/* ── Profile Menu Navigation Buttons ────────────── */
.menu-nav-btn {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1rem;
    text-align: left;
    width: 100%;
}
